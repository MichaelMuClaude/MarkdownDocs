[Desktop Entry]
Type=Application
Name=MarkdownDocs
GenericName=Document Editor
Comment=Markdown-first document editor for working with AI agents; opens Word files too
Exec=markdowndocs %F
TryExec=markdowndocs
Icon=io.github.michaelmuclaude.markdowndocs
Terminal=false
StartupNotify=true
StartupWMClass=io.github.michaelmuclaude.markdowndocs
Categories=Office;WordProcessor;
Keywords=markdown;md;word;document;docx;editor;agent;ai;
MimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.ms-word.document.macroEnabled.12;application/vnd.openxmlformats-officedocument.wordprocessingml.template;application/vnd.ms-word.template.macroEnabled.12;application/msword;application/msword-template;application/vnd.oasis.opendocument.text;application/rtf;text/rtf;text/markdown;text/x-markdown;text/x-tex;text/html;text/plain;
