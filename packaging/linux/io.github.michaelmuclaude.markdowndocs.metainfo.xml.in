<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>io.github.michaelmuclaude.markdowndocs</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>MarkdownDocs</name>
  <summary>Markdown-first document editor for working with AI agents</summary>
  <developer id="io.github.michaelmuclaude">
    <name>MarkdownDocs contributors</name>
  </developer>
  <description>
    <p>
      MarkdownDocs is an open-source document editor built for AI agents first, with Markdown as its native format: an agent edits the .md file directly and the open window follows it, while people read and edit the laid-out page. It reads and writes .md and .docx, opens ODT, RTF and HTML, exports PDF, and can be driven over MCP. It is a fork of WordCraft.
    </p>
  </description>
  <launchable type="desktop-id">io.github.michaelmuclaude.markdowndocs.desktop</launchable>
  <icon type="stock">io.github.michaelmuclaude.markdowndocs</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/MichaelMuClaude/MarkdownDocs</url>
  <url type="bugtracker">https://github.com/MichaelMuClaude/MarkdownDocs/issues</url>
  <url type="help">https://github.com/MichaelMuClaude/MarkdownDocs</url>
  <categories>
    <category>Office</category>
    <category>WordProcessor</category>
  </categories>
  <keywords>
    <keyword>markdown</keyword>
    <keyword>word processor</keyword>
    <keyword>docx</keyword>
    <keyword>document</keyword>
    <keyword>writer</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>The Open Studio Handbook sample with the Navigation pane</caption>
      <image>https://raw.githubusercontent.com/MichaelMuClaude/MarkdownDocs/main/docs/images/hero.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#99d6cf</color>
    <color type="primary" scheme_preference="dark">#0f766e</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <!-- Document types MarkdownDocs opens (#295), as in the desktop entry's MimeType=. -->
  <provides>
    <binary>markdowndocs</binary>
    <mediatype>text/markdown</mediatype>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.document</mediatype>
    <mediatype>application/vnd.ms-word.document.macroEnabled.12</mediatype>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.template</mediatype>
    <mediatype>application/vnd.ms-word.template.macroEnabled.12</mediatype>
    <mediatype>application/msword</mediatype>
    <mediatype>application/msword-template</mediatype>
    <mediatype>application/vnd.oasis.opendocument.text</mediatype>
    <mediatype>application/rtf</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
